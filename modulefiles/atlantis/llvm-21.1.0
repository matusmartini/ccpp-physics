#%Module
#
# neptune-atmos wrapper module
#

proc ModulesHelp {} {
    puts -nonewline stderr "Load neptune-atmos environment on Atlantis for spack-stack with clang-21.1.0"
}

module-whatis "neptune-atmos environment"

# Conflicts
conflict atlantis

# Prerequisite modules
module purge
prepend-path MODULEPATH /gpfs/neptune/spack-stack/llvm-21.1.0/modulefiles
prepend-path MODULEPATH /gpfs/neptune/spack-stack/openmpi-4.1.8/llvm-21.1.0/modulefiles
module load slurm

# spack-stack modules
prepend-path MODULEPATH /gpfs/neptune/spack-stack/spack-stack-2.0.0/envs/ne-clang-21.1.0/modules/Core
module load stack-llvm/21.1.0
module load stack-openmpi/4.1.8
module load python/3.11.11
module load cmake/3.31.8
